# Configure no deploy environment; nunca coloque valores reais aqui.
MONGODB_URI=
MONGODB_DB=zaindu_clinica
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Só no servidor: permite criar, trocar a senha e remover logins pela tela Equipe.
SUPABASE_SECRET_KEY=
# Contas que abrem /admin (separadas por vírgula). Padrão: admin@zaindu.app
ZAINDU_ADMIN_EMAILS=

# Envio de e-mails pelo Resend (somente no servidor)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
